DEEPSEEK_API_KEY=sk-your-key-here
PORT=3022
AUTO_PROCESS=false # 设为 true 则在启动时自动从 Raw Product CSV 清洗和处理，生成 Exposed CSV 文件
AUTO_INGEST=false # 设为 true 则在启动时自动从 Exposed CSV 文件对向量数据库 ingest 数据
CHAT_LOG=false

# OpenRouter 配置 —— 用于多模态图片解析
OPENROUTER_API_KEY=sk-your-key-here
OPENROUTER_MODEL=qwen/qwen3.7-plus

# 安全配置
JWT_ACCESS_SECRET=change-me-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-a-different-prod-refresh-secret
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=change-me-admin-password
DB_DIR=data
