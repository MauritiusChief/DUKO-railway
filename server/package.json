{
  "name": "duko-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run db:process && npm run db:ingest",
    "build": "tsc && md dist\\data 2>nul & xcopy src\\data\\sku.sqlite dist\\data\\ /Y && rd /s /q dist\\data\\sku.lance 2>nul & xcopy src\\data\\sku.lance dist\\data\\sku.lance\\ /E /Y /I",
    "start": "node dist/index.js",
    "db:ingest": "tsx src/ingest-cli.ts",
    "db:process": "tsx src/process-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@types/papaparse": "^5.5.2",
    "@huggingface/transformers": "^4.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-table": "^3.0.4",
    "minisearch": "^7.2.0",
    "openai": "^4.77.0",
    "papaparse": "^5.5.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
