# Railway server 的 WebSocket 端点（生产用 wss://，本地调试可 ws://）
AUTO_SERVER_URL=wss://your-railway-domain.up.railway.app/api/auto/connect
# AUTO_SERVER_URL=ws://localhost:3023/api/auto/connect

# Worker 鉴权 token —— 必须与 server/.env 中的 AUTO_WORKER_TOKEN 完全一致
AUTO_WORKER_TOKEN=replace-with-long-random-token

# Chromium 用户数据目录（持久化 Odoo 登录状态）
AUTO_PROFILE_DIR=./data/browser-profile

# Odoo 入口地址
ODOO_BASE_URL=https://dukouserp.com/odoo/

# 是否使用无头模式（首版需要 headed 以保留登录交互）
AUTO_HEADLESS=false

# 用户确认超时（毫秒），默认 300000（5 分钟）
AUTO_CONFIRM_TIMEOUT_MS=300000
